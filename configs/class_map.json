  "contrast_stretch_specification": {
    "source_dataset": "COPERNICUS/S2_HARMONIZED (TOA Reflectance)",
    "target_bands": ["B4", "B3", "B2"],
    "band_order": "RGB",
    "native_scale_factor": 10000.0,
    "clip_min_dn": 0,
    "clip_max_dn": 3500,
    "clip_min_reflectance": 0.0,
    "clip_max_reflectance": 0.35,
    "output_dtype": "uint8",
    "output_range": [0, 255],
    "stretch_formula": "uint8_pixel = np.clip((DN / 3500.0) * 255.0, 0, 255).astype(np.uint8)",
    "documentation": {
      "eurosat_contrast_matching": "EuroSAT RGB images were constructed by German Research Center for AI (DFKI) from Sentinel-2 Level-1C (TOA) tiles. Raw 12-bit DNs [0, 10000] were clipped to the typical optical surface reflectance range [0, 3000-4000] and linearly scaled to [0, 255]. Our fixed clipping ceiling of DN=3500 (reflectance 0.35) reproduces EuroSAT's mean brightness of ~128 and dynamic range without saturation.",
      "domain_shift_differences": "EuroSAT images originate from European tiles collected in 2015-2016 under temperate sun-elevation angles. The India shift set introduces distinct agro-ecological conditions (tropical monsoons, arid Rajasthani soil reflectance, intensive Panjabi wheat-rice cycles) and seasonal illumination shifts."
    }
  },
